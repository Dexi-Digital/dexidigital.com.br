# Radar de concorrência — semanal, segunda às 08:00 de Brasília.
#
# Uma hora antes do cron do blog (09:00) de propósito: se a curadoria da semana
# anterior deixou pauta aprovada, ela já está na fila quando o gerador rodar.
#
# Semanal e não diário porque blog de concorrente publica em ritmo de semana.
# Rodar todo dia só geraria log repetido — o dedup descartaria tudo.
CRON_TZ=America/Sao_Paulo
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 8 * * 1 root /usr/local/bin/dexi-radar.sh >> /var/log/dexi-radar.log 2>&1
