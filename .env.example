# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For server-side operations (admin access)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Email Configuration (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email sender address (must be verified in Resend)
EMAIL_FROM=Dexi Digital <contato@dexidigital.com.br>

# Internal notification email (receives lead alerts)
INTERNAL_NOTIFICATION_EMAIL=contato@dexidigital.com.br

# Google Analytics 4 (Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OpenAI Ads Pixel (conversion tracking for ChatGPT ads)
NEXT_PUBLIC_OPENAI_PIXEL_ID=your-openai-pixel-id

# OpenAI Ads Conversions API (server-side, secret — never expose to client)
OPENAI_ADS_CONVERSION_API_KEY=sk-svcacct-xxxxxxxxxxxx

# News APIs (GNews + WorldNewsAPI) — server-only, secret
GNEWS_API_KEY=your-gnews-api-key
WORLDNEWS_API_KEY=your-worldnews-api-key

# Gemini API (geração de posts do blog) — server-only, secret
GEMINI_API_KEY=your-gemini-api-key

# Slack Incoming Webhook — avisa quando um post é publicado e quando a geração
# falha. Opcional: sem ela o cron roda normal, só não notifica.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

